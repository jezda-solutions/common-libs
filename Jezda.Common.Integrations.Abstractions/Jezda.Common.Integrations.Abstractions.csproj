<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>Jezda.Common.Integrations.Abstractions</PackageId>
    <Version>1.0.0</Version>
    <Description>Abstractions for external task provider integrations. Includes IExternalTaskProvider interface, shared DTOs, and resilience defaults for GitHub, Jira, and Azure DevOps integrations.</Description>
    <PackageTags>integrations;task-provider;github;jira;azure-devops;abstractions</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.7.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
