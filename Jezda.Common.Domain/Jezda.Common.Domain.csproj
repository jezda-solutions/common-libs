<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<PackageId>Jezda.Common.Domain</PackageId>
		<Version>1.0.0</Version>
		<Description>Common domain models, base entities, and value objects. Includes BaseEntity, IDeletedEntity interface, PagedList, PagingInfo, and domain enums.</Description>
		<PackageTags>domain;entities;ddd;domain-driven-design;base-entity;pagination;value-objects</PackageTags>
		<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>

	<ItemGroup>
		<!-- Only [QueryParam]/[BindFrom] are used (PagingInfo); the attributes package keeps
		     consumers free to stay on any FastEndpoints major. -->
		<PackageReference Include="FastEndpoints.Attributes" Version="8.3.0" />
	</ItemGroup>

	<ItemGroup>
		<!-- [FromQuery] in PagingInfo comes from ASP.NET Core MVC. -->
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="/" />
	</ItemGroup>

</Project>
